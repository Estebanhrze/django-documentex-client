# Django: usar valores distintos y secretos para cada entorno.
DJANGO_SECRET_KEY=replace-with-a-long-random-django-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=0

# Conexión servidor-a-servidor con FastAPI. Nunca exponer este secreto al navegador.
DOCUMENTS_API_BASE_URL=https://documents-api.fastapicloud.dev
DOCUMENTS_API_SHARED_SECRET=replace-with-the-same-long-random-secret-as-fastapi
DOCUMENTS_API_TIMEOUT_SECONDS=30